# Supabase Postgres connection string (Phase 0b)
DATABASE_URL=

# Supabase project URL + service role key (Phase 0b)
# Same project as DATABASE_URL. Used for FILE STORAGE — users upload their
# resume through the app into the private `resumes` bucket. Never a local folder.
# Service role key is server-side only — must never reach the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio — aistudio.google.com (free, no card) (Phase 2)
GEMINI_API_KEY=

# Groq — console.groq.com (free, no card) (Phase 2)
GROQ_API_KEY=

# Voyage AI — voyageai.com (free 200M tokens on voyage-4, no card). EMBEDDINGS
# provider (Phase 3). Replaced Gemini embeddings, which cap at 1,000/day.
VOYAGE_API_KEY=
# Optional override; defaults to voyage-4 (1024-dim).
VOYAGE_MODEL=

# GitHub personal access token — raises unauth rate limit 60/hr -> 5,000/hr (Phase 2)
GITHUB_TOKEN=
