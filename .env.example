# Supabase Postgres connection string (Phase 0b)
DATABASE_URL=

# Supabase project URL + service role key (Phase 0b)
# Same project as DATABASE_URL. Used for FILE STORAGE — users upload their
# resume through the app into the private `resumes` bucket. Never a local folder.
# Service role key is server-side only — must never reach the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth (Phase A) — anonymous-first sessions, Google OAuth to upgrade.
# Same project again. These two are the ONLY Supabase values that belong in the
# browser bundle, which is what the NEXT_PUBLIC_ prefix means: Next inlines them
# into client JS at build time. The anon/publishable key is designed for that
# and is safe there. SUPABASE_SERVICE_ROLE_KEY above is NOT — it bypasses every
# check in the project. Never give it a NEXT_PUBLIC_ name.
#
# Key: dashboard -> Settings -> API Keys. Either the legacy `anon` JWT or a
# newer `sb_publishable_...` key works.
# URL: same value as SUPABASE_URL. Set it here too — the browser cannot read
# the unprefixed one.
#
# Two project settings must also be ON, and neither one fails loudly if it is
# not (Authentication -> Sign In / Providers):
#   - "Allow anonymous sign-ins"  — without it every logged-out visitor, which
#     is most of them, cannot get a session at all.
#   - "Allow manual linking"      — without it the anonymous -> Google upgrade
#     cannot keep the same auth uid and every sign-in becomes a data merge.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- LLM providers -----------------------------------------------------------
# Four different providers, each with ONE API key (one account each) — not
# multiple keys for the same provider. lib/llm falls back from one provider to
# the next on a rate limit (e.g. Groq -> Cerebras -> Gemini), it does not
# rotate between several keys of a single provider.
# lib/llm also accepts a comma-separated list per var (GROQ_API_KEYS=key1,key2)
# for anyone who does want multi-key rotation on one provider, but that is not
# how this project's own .env is configured — use the singular *_API_KEY vars
# below as the default.
#
# Measured free-tier limits per key (2026-07):
#   Groq     — PER MODEL, not per key and not per family (measured from the
#              x-ratelimit headers): 8k tokens/min and 1000 requests/day EACH
#              for gpt-oss-120b, gpt-oss-20b and qwen3.6-27b. The workhorse:
#              gpt-oss-120b is what holds our large nested schemas, but the
#              other two can tool-call, so the chat chain uses all three and
#              gets 24k TPM out of one account. See chatModelChain() in
#              lib/llm/index.ts. Groq's Meta llama models are being
#              decommissioned — do not add them to any chain.
#   Cerebras — 30k tokens/min but only 5 requests/min, 2400/day. Fast; used
#              where the schema is small (job re-rank).
#   Gemini   — only 20 requests/DAY. Last-resort fallback only, never a primary.

# Groq — console.groq.com (free, no card)
GROQ_API_KEY=

# Cerebras — cloud.cerebras.ai (free, no card)
CEREBRAS_API_KEY=

# Google AI Studio — aistudio.google.com (free, no card)
GEMINI_API_KEY=

# Cohere — dashboard.cohere.com (free trial key, no card; 2,000 inputs/min,
# 1,000 calls/month). EMBEDDINGS provider (Phase 3): embed-v4.0 @ 1024-dim.
COHERE_API_KEY=
# Optional override; defaults to embed-v4.0 (1024-dim).
COHERE_MODEL=

# --- Bring your own key (Phase D) ---------------------------------------------
# Encrypts the provider API keys USERS give us, at rest, with AES-256-GCM
# (lib/keys/crypto.ts). Unlike every other key in this file this one is not a
# provider credential from somebody's dashboard — it is generated by and owned
# by this deployment. Never reuse another secret for it.
#
#   openssl rand -hex 32
#
# 32 bytes: 64 hex characters, or 44 base64 characters. Anything else is
# rejected at startup with a log line and bring-your-own-key stays switched off
# (the app is otherwise unaffected — it just keeps using the shared pool).
#
# Rotating this makes every already-stored user key undecryptable. There is no
# re-wrap path on purpose: the recovery is to ask users to paste their key
# again, which costs them a minute and costs us nothing we should have kept.
ENCRYPTION_KEY=

# --- Per-user daily quotas (Phase D) ------------------------------------------
# Optional. Defaults are in lib/usage/quota.ts and are sized against ~1,500
# chat turns/day of total free-tier capacity (3 groq chat models x 1000
# requests/day, ~2 requests per tool-calling turn). Raise them when the shared
# pool is idle, lower them when it is not; a user who brings their own key is
# never counted at all. Quotas reset at 00:00 UTC.
QUOTA_CHAT_TURNS=          # signed in, default 40
QUOTA_SEARCHES=            # signed in, default 5
QUOTA_ANON_CHAT_TURNS=     # anonymous, default 10
QUOTA_ANON_SEARCHES=       # anonymous, default 1

# GitHub personal access token — raises unauth rate limit 60/hr -> 5,000/hr (Phase 2)
GITHUB_TOKEN=

# Klipy (GIF/meme search) — key from partner.klipy.com. Free: a test key allows
# 100 calls/hour, a production key is uncapped. Replaced Tenor, which Google
# shut down on 2026-06-30.
# OPTIONAL. Fallback for the agent's meme reactions when the curated pack in
# public/memes/ has nothing for a mood. Without it, only curated memes send —
# the feature degrades quietly, it never errors.
KLIPY_API_KEY=
# Optional; defaults to en_IN so results lean Indian/Hinglish.
KLIPY_LOCALE=
