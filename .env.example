# Supabase Postgres connection string (Phase 0b)
DATABASE_URL=

# Supabase project URL + service role key (Phase 0b)
# Same project as DATABASE_URL. Used for FILE STORAGE — users upload their
# resume through the app into the private `resumes` bucket. Never a local folder.
# Service role key is server-side only — must never reach the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM providers -----------------------------------------------------------
# Four different providers, each with ONE API key (one account each) — not
# multiple keys for the same provider. lib/llm falls back from one provider to
# the next on a rate limit (e.g. Groq -> Cerebras -> Gemini), it does not
# rotate between several keys of a single provider.
# lib/llm also accepts a comma-separated list per var (GROQ_API_KEYS=key1,key2)
# for anyone who does want multi-key rotation on one provider, but that is not
# how this project's own .env is configured — use the singular *_API_KEY vars
# below as the default.
#
# Measured free-tier limits per key (2026-07):
#   Groq     — 8k tokens/min, 1000 requests/day. The workhorse: the only
#              provider that reliably holds our large nested schemas.
#   Cerebras — 30k tokens/min but only 5 requests/min, 2400/day. Fast; used
#              where the schema is small (job re-rank).
#   Gemini   — only 20 requests/DAY. Last-resort fallback only, never a primary.

# Groq — console.groq.com (free, no card)
GROQ_API_KEY=

# Cerebras — cloud.cerebras.ai (free, no card)
CEREBRAS_API_KEY=

# Google AI Studio — aistudio.google.com (free, no card)
GEMINI_API_KEY=

# Cohere — dashboard.cohere.com (free trial key, no card; 2,000 inputs/min,
# 1,000 calls/month). EMBEDDINGS provider (Phase 3): embed-v4.0 @ 1024-dim.
COHERE_API_KEY=
# Optional override; defaults to embed-v4.0 (1024-dim).
COHERE_MODEL=

# GitHub personal access token — raises unauth rate limit 60/hr -> 5,000/hr (Phase 2)
GITHUB_TOKEN=

# Klipy (GIF/meme search) — key from partner.klipy.com. Free: a test key allows
# 100 calls/hour, a production key is uncapped. Replaced Tenor, which Google
# shut down on 2026-06-30.
# OPTIONAL. Fallback for the agent's meme reactions when the curated pack in
# public/memes/ has nothing for a mood. Without it, only curated memes send —
# the feature degrades quietly, it never errors.
KLIPY_API_KEY=
# Optional; defaults to en_IN so results lean Indian/Hinglish.
KLIPY_LOCALE=
